{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "types": [],
    "paths": {
      "@hellonexus/ui": ["./runtime/ui.tsx"],
      "@hellonexus/sdk": ["./runtime/sdk.ts"]
    }
  },
  "include": ["runtime", "widgets"]
}
